# Sunucu
PORT=3001
CLIENT_ORIGIN=*

# MySQL — bağlanamazsa oyun yine çalışır, sadece skor kaydı kapanır
DB_ENABLED=true
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pill_arena

# Maç sırasında kopan oyuncuya tanınan yeniden bağlanma süresi (ms).
# Bu süre içinde dönerse elenmez, kaldığı yerden devam eder.
DISCONNECT_GRACE_MS=20000
